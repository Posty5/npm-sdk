{
    "name": "@posty5/qr-design",
    "version": "4.7.0",
    "description": "Posty5 QR design engine: deterministic SVG rendering of QR designs (shapes, gradients, frames) and scannability checks, identical in Node and the browser",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "sideEffects": false,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Posty5/npm-sdk.git"
    },
    "homepage": "https://github.com/Posty5/npm-sdk#readme",
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE",
        "OFL.txt"
    ],
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "build:glyphs": "node scripts/build-glyphs.mjs",
        "golden:update": "npm run build && node scripts/update-golden.mjs",
        "test": "jest --config ../jest.config.js --selectProjects qr-design",
        "typecheck": "tsc --noEmit",
        "prepublishOnly": "npm run build"
    },
    "keywords": [
        "posty5",
        "qr-code",
        "qr-design",
        "svg",
        "scannability",
        "typescript"
    ],
    "author": "Posty5",
    "license": "MIT",
    "devDependencies": {
        "@fontsource/noto-sans": "^5.1.0",
        "@fontsource/noto-sans-arabic": "^5.1.0",
        "@types/node": "^20.0.0",
        "@zxing/library": "^0.23.0",
        "jest-environment-jsdom": "^29.7.0",
        "opentype.js": "2.0.0",
        "qrcode-generator": "2.0.4",
        "sharp": "^0.34.5",
        "tsup": "^8.0.0",
        "typescript": "^5.3.0"
    }
}
