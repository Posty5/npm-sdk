{
  "//": "ts-jest settings for @posty5/qr-design. Self-contained: no live API, no root setup.ts.",
  "compilerOptions": {
    "strict": true,
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2020", "DOM"],
    "types": ["jest", "node"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": false
  },
  "include": ["./**/*.ts", "../src/**/*.ts"]
}
